DATABASE_URL="file:./dev.db"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="change-me"
# Initial accounts created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="admin1234"
SEED_VIEWER_EMAIL="viewer@example.com"
SEED_VIEWER_PASSWORD="viewer1234"

# Production only: required by Auth.js when not hosted on Vercel, plus the public URL.
# AUTH_TRUST_HOST=true
# AUTH_URL="https://techdex.yourcompany.local"
